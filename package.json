{
  "name": "rustify-hackathon-2025",
  "scripts": {
    "dev": "concurrently \"npm run dev:rust\" \"npm run dev:client\" --names \"🦀RUST,⚛️CLIENT\" --prefix-colors \"red,blue\" --kill-others-on-fail",
    "dev:rust": "cd rust-core && ./dev.sh",
    "dev:client": "sleep 5 && cd client && npm run dev",
    "build": "npm run build:rust && npm run build:client",
    "build:rust": "cd rust-core && ./build.sh",
    "build:client": "cd client && npm run build",
    "postinstall": "npm install --prefix client",
    "clean": "rm -rf client/dist client/node_modules rust-core/target client/src/wasm/package target node_modules",
    "prettier": "prettier --write '**/*.{js,jsx,json,css,md}'"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "concurrently": "^8.2.2",
    "prettier": "^3.0.1"
  }
}